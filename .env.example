# Backend API base URL (server-only). Local backend: http://localhost:5000/api/v1
BACKEND_API_URL=http://localhost:5000/api/v1

# Frontend origin (public). Used for metadata and absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in (public). The OAuth client ID from Google Cloud Console. The backend needs the same
# value as its GOOGLE_CLIENT_ID. Leave blank to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# One-click demo login (server-only). Leave a pair blank to disable that role's button.
# Demo accounts come from the backend seed (npx prisma db seed).
DEMO_ADMIN_EMAIL=admin@carenest.com
DEMO_ADMIN_PASSWORD=CareNest@Admin2026

DEMO_STAFF_EMAIL=sitter.demo@carenest.com
DEMO_STAFF_PASSWORD=CareNest@Staff2026

DEMO_DRIVER_EMAIL=driver.demo@carenest.com
DEMO_DRIVER_PASSWORD=CareNest@Staff2026

DEMO_GUARDIAN_EMAIL=guardian.demo@carenest.com
DEMO_GUARDIAN_PASSWORD=CareNest@Guardian2026
